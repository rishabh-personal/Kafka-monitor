# Copy this to .env for local development
# Set these as Environment Variables in DigitalOcean App Platform

# UI protection (required for production)
UI_PASSWORD=your-secure-password
SESSION_SECRET=your-random-secret-at-least-32-chars

# Kafbat UI (formerly Kafka UI) — https://jio-kafka-ui.prod.zwing.in/
KAFKA_UI_URL=https://jio-kafka-ui.prod.zwing.in
CLUSTER_NAME=kafka-prod

# Kafbat auth (GitHub OAuth): sign in via browser, then copy session cookie
# DevTools → Application → Cookies → SESSION (or paste full Cookie header value)
KAFKA_UI_SESSION_COOKIE=

# Optional: bearer JWT if your Kafbat instance has OAuth2 resource-server configured
# KAFKA_UI_BEARER_TOKEN=

# Legacy form login (only if Kafbat auth.type is LOGIN_FORM, not OAuth)
# KAFKA_UI_USER=
# KAFKA_UI_PASS=

SLACK_WEBHOOK=your-slack-incoming-webhook-url
APP_URL=https://your-app.ondigitalocean.app
CHECK_INTERVAL=*/15 * * * *

# Lag alerts
LAG_THRESHOLD=10000
# Alert when lag grows by this much between checks (default 5000)
LAG_VELOCITY_THRESHOLD=5000
# Per-group SLO overrides: groupId:limit, supports wildcards e.g. *critical*:5000
# LAG_SLO_OVERRIDES=ginesys-crm-butler-queue:100,*ingress*:5000

# Stuck offset: partition lag >= this and offset unchanged for STUCK_OFFSET_CHECKS checks
STUCK_OFFSET_MIN_LAG=1000
STUCK_OFFSET_CHECKS=2

CHECK_PARTITION_BALANCE=true
CHECK_DEBEZIUM_TOPICS=true

# Pipeline / orphan topic checks (connector topics without consumers, missing topics)
CHECK_ORPHAN_TOPICS=true
# Full zombie scan (no producers + no consumers) — expensive; off by default
ORPHAN_ZOMBIE_SCAN=false
ORPHAN_TOPIC_SCAN_LIMIT=50

PORT=3000
